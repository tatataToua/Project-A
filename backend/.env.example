# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql+psycopg://askme:askme@localhost:5432/askme

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random long string used to sign the session cookie -- generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173

# Set to true only once served over HTTPS (production); keep false for local dev.
SESSION_COOKIE_SECURE=false
