# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Any OpenAI-compatible endpoint works here, including a local Ollama server.
# Defaults to Gemini's OpenAI-compatible endpoint:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For local Ollama (pair with e.g. GEMINI_MODEL=qwen2.5:7b-instruct and
# GEMINI_EMBEDDING_MODEL=nomic-embed-text):
# GEMINI_BASE_URL=http://localhost:11434/v1

GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Must match the `embeddings` table's vector width. Changing it after the table
# exists requires `DROP TABLE embeddings;` and a re-ingest -- see app/models.py.
EMBEDDING_DIMENSIONS=768

# How many chunks retrieval feeds into the answer prompt.
RETRIEVAL_TOP_K=5

# Candidates fetched per branch (vector + full-text) before fusion/reranking.
RETRIEVAL_OVERFETCH_K=15

# Longest accepted /chat message, in characters.
CHAT_MESSAGE_MAX_LENGTH=2000

# Cross-encoder model for reranking.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

DATABASE_URL=postgresql+psycopg://askme:askme@localhost:5432/askme

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random long string (>= 32 chars) used to sign the session cookie -- generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave it unset only for local dev: the app then signs with a random
# per-process key (logins die on restart) and refuses to start outright when
# SESSION_COOKIE_SECURE=true.
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173

# Set to true only once served over HTTPS (production); keep false for local dev.
SESSION_COOKIE_SECURE=false
